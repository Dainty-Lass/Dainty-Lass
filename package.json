{
  "name": "dainty-lass",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "ui",
    "ui/apps/*",
    "ui/packages/*",
    "launcher"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "bridge-data": "bun run --cwd ui bridge-data && bun run --cwd launcher bridge-data",
    "typecheck": "bun run --cwd ui typecheck && bun run --cwd launcher typecheck",
    "test": "bun run --cwd ui test && bun run --cwd launcher test",
    "dev": "bun run --cwd launcher dev",
    "dev:manager": "bun run --cwd launcher dev:manager",
    "lint":"bun run --cwd ui lint",
    "build": "bun run --cwd ui build"
  },
  "trustedDependencies": [
    "@astryxdesign/core"
  ],
  "overrides": {
    "fflate": "0.7.5"
  },
  "patchedDependencies": {
    "vinext@1.3.0": "ui/patches/vinext@1.3.0.patch"
  }
}
