{
 "steps": [
  {
   "name": "features",
   "method": "GET",
   "path": "/features/platform/win"
  },
  {
   "name": "link epic",
   "method": "GET",
   "path": "/account/link/epic/ABC"
  },
  {
   "name": "is banned",
   "method": "GET",
   "path": "/isbanned"
  },
  {
   "name": "accountinfo",
   "method": "GET",
   "path": "/accountinfo",
   "headers": {
    "authorization": "Bearer {{tok}}"
   }
  },
  {
   "name": "accountinfo without a token",
   "method": "GET",
   "path": "/accountinfo"
  },
  {
   "name": "tags",
   "method": "GET",
   "path": "/tags",
   "headers": {
    "authorization": "Bearer {{tok}}"
   }
  },
  {
   "name": "game session",
   "method": "PUT",
   "path": "/gamesession/epic",
   "headers": {
    "authorization": "Bearer {{tok}}"
   }
  },
  {
   "name": "game session epiceos",
   "method": "PUT",
   "path": "/gamesession/epiceos",
   "headers": {
    "authorization": "Bearer {{tok}}"
   }
  },
  {
   "name": "public accountinfo",
   "method": "POST",
   "path": "/accountinfo/public",
   "headers": {
    "authorization": "Bearer {{tok}}"
   },
   "json": {
    "accountId": "u1"
   }
  },
  {
   "name": "public accountinfo, unknown",
   "method": "POST",
   "path": "/accountinfo/public",
   "headers": {
    "authorization": "Bearer {{tok}}"
   },
   "json": {
    "accountId": "nobody"
   }
  },
  {
   "name": "public accountinfo, no body",
   "method": "POST",
   "path": "/accountinfo/public",
   "headers": {
    "authorization": "Bearer {{tok}}"
   }
  },
  {
   "name": "login",
   "method": "POST",
   "path": "/login",
   "headers": {
    "authorization": "Bearer {{tok}}"
   },
   "json": {
    "email": "u1"
   }
  },
  {
   "name": "login, another email",
   "method": "POST",
   "path": "/login",
   "headers": {
    "authorization": "Bearer {{tok}}"
   },
   "json": {
    "email": "u2"
   }
  },
  {
   "name": "migration status",
   "method": "GET",
   "path": "/migration/status",
   "headers": {
    "authorization": "Bearer {{tok}}"
   }
  },
  {
   "name": "key generate",
   "method": "POST",
   "path": "/key/generate",
   "headers": {
    "authorization": "Bearer {{tok}}"
   },
   "json": {
    "candidateId": "c1"
   }
  },
  {
   "name": "key generate without a token",
   "method": "POST",
   "path": "/key/generate",
   "json": {}
  },
  {
   "name": "key consume",
   "method": "POST",
   "path": "/key/consume",
   "headers": {
    "authorization": "Bearer {{tok}}"
   },
   "json": {
    "candidateId": "c1"
   }
  }
 ]
}