{
  "name": "@dainty/theme",
  "version": "0.1.0",
  "description": "Dainty Lass's one theme: the Astryx theme, the CSS stack and the colour-mode provider every app uses",
  "type": "module",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./mode": "./src/mode.ts",
    "./theme": "./src/dainty.theme.ts",
    "./built": "./built/dainty.js",
    "./theme.css": "./built/dainty.theme.css",
    "./base.css": "./src/base.css",
    "./brand.css": "./src/brand.css"
  },
  "scripts": {
    "build": "astryx theme build src/dainty.theme.ts -o built/dainty.theme.css",
    "check": "astryx theme build src/dainty.theme.ts -o built/dainty.theme.css --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test --pass-with-no-tests"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.17",
    "@astryxdesign/theme-neutral": "^0.7.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.17",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "tailwindcss": "^4.3.3"
  }
}
