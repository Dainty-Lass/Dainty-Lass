{
  "name": "dainty-dash",
  "version": "0.1.0",
  "description": "DaintyLass's remote management dashboard, launcher page and server manager page, on one theme",
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "astryx": {
    "theme": "neutral"
  },
  "scripts": {
    "dev": "bun run --filter @dainty/web dev",
    "dev:launcher": "bun run --filter @dainty/web dev:launcher",
    "dev:manager": "bun run --filter @dainty/web dev:manager",
    "build": "bun run --filter @dainty/theme build && bun run --filter './apps/*' build",
    "build:launcher": "bun run --filter @dainty/theme build && bun run --filter @dainty/web build:launcher",
    "build:manager": "bun run --filter @dainty/theme build && bun run --filter @dainty/web build:manager",
    "start": "bun run --filter @dainty/web start",
    "theme:build": "bun run --filter @dainty/theme build",
    "restricted-data": "bun packages/bridge/scripts/restricted-data.ts",
    "db:generate": "bun run --filter @dainty/web db:generate",
    "typecheck": "bun run restricted-data && bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@astryxdesign/core"
  ],
  "patchedDependencies": {
    "vinext@1.3.0": "patches/vinext@1.3.0.patch"
  }
}
