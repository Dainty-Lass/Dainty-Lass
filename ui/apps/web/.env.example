# The dashboard's environment (docs/integration.md). Everything a person tunes is in Settings instead.

# The public origin, behind your TLS reverse proxy. OAuth redirects are <this>/api/auth/callback/<provider>.
# Passkeys are bound to its hostname.
DASHBOARD_BASE_URL=http://localhost:3000

# Signs sessions and encrypts stored provider tokens: 32+ random characters. Generated into the data
# folder when unset; keep it with the database.
#DASHBOARD_AUTH_SECRET=

# Sign-in (docs/access.md). No passwords: each provider is offered when it is configured; passkeys always.
# A Discord application (discord.com/developers): OAuth2 client id and secret.
DASHBOARD_DISCORD_CLIENT_ID=
DASHBOARD_DISCORD_CLIENT_SECRET=
# Its bot, in your guild with Manage Roles, so accepting the terms can add the approved role.
DASHBOARD_DISCORD_BOT_TOKEN=
# A Twitch application (dev.twitch.tv/console).
DASHBOARD_TWITCH_CLIENT_ID=
DASHBOARD_TWITCH_CLIENT_SECRET=
# Email sign-in codes: smtp(s)://user:pass@host:port and the From address.
DASHBOARD_SMTP_URL=
DASHBOARD_MAIL_FROM=

# Owners from sign-in: comma-separated Discord user ids, and confirmed email addresses.
DASHBOARD_OWNER_DISCORD_IDS=
DASHBOARD_OWNER_EMAILS=

# The admin service's GraphQL, and DAINTY_ADMIN_API_KEY from the host kit's secrets.env.
DASHBOARD_ADMIN_API_URL=http://127.0.0.1:61003/graphql
DASHBOARD_ADMIN_API_KEY=

# The backend, and RUSTIC_ISLES_MANAGER_OPERATOR_SECRET from secrets.env (the backend needs RUSTIC_ISLES_MANAGER_ADMIN=on).
DASHBOARD_BACKEND_URL=http://127.0.0.1:61000
DASHBOARD_MANAGER_OPERATOR_SECRET=

# What the backend sends with chat and reports: 32 or more random characters. Ingest is off without it.
DASHBOARD_INGEST_KEY=

# Where the database lives (default ./data/dashboard.db).
#DASHBOARD_DATA_DIR=./data
#DASHBOARD_SESSION_DAYS=7

# Development only, ignored in production: one-click sign-in as each tier, and email codes printed to the
# console when SMTP is not set.
#DASHBOARD_DEV_LOGIN=on
