{
  "productName": "DaintyLass Manager",
  "mainBinaryName": "dainty-manager",
  "identifier": "io.github.freezamotoqueiro.dauntlessreforgedrevival.server",
  "build": {
    "devUrl": "http://localhost:4322",
    "frontendDist": "../dist/server-manager",
    "beforeDevCommand": "bun scripts/lass.ts dashboard-page dev server-manager",
    "beforeBuildCommand": "bun scripts/lass.ts dashboard-page build server-manager"
  },
  "bundle": {
    "icon": [
      "icons/server/32x32.png",
      "icons/server/128x128.png",
      "icons/server/128x128@2x.png",
      "icons/server/icon.icns",
      "icons/server/icon.ico"
    ],
    "shortDescription": "DaintyLass Manager — community server manager",
    "longDescription": "Set up, start, stop, migrate, and administer a DaintyLass community server with its services compiled in.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/server/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/manager.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/manager.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/FreezaMotoqueiro/Dauntless-Reforged-Revival/releases/download/launcher-updates/latest-manager.json"
      ]
    }
  }
}
