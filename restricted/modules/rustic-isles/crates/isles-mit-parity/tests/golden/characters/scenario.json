    { "name": "get characters of two", "as": "player:alice", "method": "GET", "path": "/character" },
    { "setEnv": { "GAMESERVER_NO_PLAYER_USER_ID": "carol" } },
    { "name": "get character for the configured no-player account", "as": "gameserver", "method": "GET", "path": "/character", "save": { "ccid": "0.id" } },
