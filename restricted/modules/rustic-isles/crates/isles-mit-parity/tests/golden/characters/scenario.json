    { "name": "update finishing the FTUE", "as": "player:alice", "method": "POST", "path": "/character", "body": { "characterId": "{cid}", "updateVersion": 7, "data": "{\"SERIE_cr19_series_1_ftue\":\"{\\\"929A333B40E413C41E47B0A425EC3349\\\":{\\\"Status\\\":3}}\"}" } },
    { "name": "update without data", "as": "player:alice", "method": "POST", "path": "/character", "body": { "characterId": "{cid}", "updateVersion": 8 } },
    { "name": "update of a character that is not theirs", "as": "player:alice", "method": "POST", "path": "/character", "body": { "characterId": "nope", "updateVersion": 50, "data": "{}" } },
