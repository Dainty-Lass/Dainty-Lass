    { "name": "gameserver names the account in the body", "as": "gameserver", "method": "POST", "path": "/character", "body": { "characterId": "{cid}", "accountId": "alice", "updateVersion": 1, "data": "{\"Server\":2}" } },
    { "name": "gameserver without an account", "as": "gameserver", "method": "POST", "path": "/character", "body": { "characterId": "{cid}", "updateVersion": 1, "data": "{}" } },
    { "name": "gameserver without a character id", "as": "gameserver", "method": "POST", "path": "/character", "body": { "accountId": "alice", "updateVersion": 1, "data": "{\"NoId\":true}" } },
    { "name": "get character after the writes", "as": "player:alice", "method": "GET", "path": "/character" },
