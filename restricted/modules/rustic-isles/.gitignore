# --- Generated SDK (dump it yourself with Dumper-7) ---
# The complete Dumper-7 CppSDK output is game-derived and is NOT distributed.
# See docs/GENERATING_SDK.md. native/runtime holds only this SDK since R21: the CatalogExporter reads it there.
native/runtime/SDK/
native/runtime/SDK.hpp
native/runtime/Assertions.inl
native/runtime/NameCollisions.inl
native/runtime/PropertyFixup.hpp
native/runtime/UnrealContainers.hpp
native/runtime/UtfN.hpp

# --- Locally generated game data (extract from your OWN installation) ---
# Progression, hunt tables, store, Slayer's Path, etc. are Phoenix Labs game data and are
# NOT distributed. Generate them with the root's CatalogExporter + dainty-host gamedata.
# See docs/GENERATING_GAME_DATA.md. Example fixtures (*.example.json) ARE committed.
game-data/1.14.7/backend/*.json
game-data/1.14.7/director/*.json
!game-data/1.14.7/backend/*.example.json
!game-data/1.14.7/director/*.example.json
game-data/1.14.7/backend/raw/
game-data/1.14.7/director/raw/
# CatalogExporter output (game data extracted from your own install)
game-data/1.14.7/exports/
Items_Analysis/

