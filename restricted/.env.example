# Settings for compose.yaml (docs/hosting-docker.md): copy to .env and edit. Server settings themselves (mode,
# address, name, hunts, multipliers ...) are setup's: docker compose run --rm host setup ...

# public: also run the allowlist helper (a public server needs it). Leave empty for a private server.
# toml: the server is managed by REFORGED_CONFIG_DIR/host.toml alone, applied at every up (public,toml for both)
# postgres: run Postgres for a host.toml whose [database] says engine = "postgres" (public,postgres)
COMPOSE_PROFILES=public
# A private server: the Tailscale network namespace (compose.tailscale.yaml); ; instead of : on Windows
#COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
#TS_AUTHKEY=tskey-auth-...

# Your Dauntless 1.14.7 folder (the one with Archon), mounted at /game: the game servers run from it.
# An empty folder works too: `docker compose run --rm host install-game` fetches 1.14.7 into <folder>/1.14.7
REFORGED_GAME_DIR=./game
# Files for the host kit's commands, mounted read-only at /import (the runtime's DLLs, game data packs)
REFORGED_IMPORT_DIR=./import
# The toml profile: the folder holding host.toml, mounted read-only at /config
REFORGED_CONFIG_DIR=./config

# Public server: the gateway's port as setup has it (443, or what you gave --public-port) ...
REFORGED_GATEWAY_PORT=443
# ... and where the host publishes it ([address:]port; the invites name setup's port, so keep them the same)
REFORGED_GATEWAY_PUBLISH=443
# The game servers' UDP ports: 8770-8777 up to 6 hunts, 8766-8777 for 10 (setup --max-hunts)
REFORGED_GAME_PORTS=8770-8777
REFORGED_GAME_PUBLISH_ADDRESS=0.0.0.0

# The commit the backend names to players (the AGPL source offer), baked in at build time:
#REFORGED_COMMIT=  (git rev-parse --short=12 HEAD)
# Image names, for a registry: <REFORGED_IMAGE>-front:<REFORGED_TAG> and <REFORGED_IMAGE>-server:<REFORGED_TAG>
#REFORGED_IMAGE=dainty-lass
#REFORGED_TAG=local
# The postgres profile's image (postgres:17 when left out)
#POSTGRES_IMAGE=postgres:17

# The network profile: four nodes of one network (oregon, new-york, uk, germany) with latency between them, for tests
# (docker compose --profile network up -d --wait network; docs/hosting-docker.md). None of this is a server's setting.
# The private network's first three octets; the nodes are .11 to .14 in it
#REFORGED_NETWORK_SUBNET=172.28.77
# Where the nodes' gateways are published, and on which ports (each node's 443)
#REFORGED_NETWORK_PUBLISH_ADDRESS=127.0.0.1
#REFORGED_NETWORK_PORT_OREGON=18441
#REFORGED_NETWORK_PORT_NEW_YORK=18442
#REFORGED_NETWORK_PORT_UK=18443
#REFORGED_NETWORK_PORT_GERMANY=18444
# Round trips between the regions in milliseconds, the canary's (each way takes half)
#REFORGED_NETWORK_RTT_OREGON_NEW_YORK=70
#REFORGED_NETWORK_RTT_OREGON_UK=140
#REFORGED_NETWORK_RTT_OREGON_GERMANY=150
#REFORGED_NETWORK_RTT_NEW_YORK_UK=75
#REFORGED_NETWORK_RTT_NEW_YORK_GERMANY=85
#REFORGED_NETWORK_RTT_UK_GERMANY=20
# Where the Docker host plays a player: its traffic to a node takes the round trip between this region and the node
#REFORGED_NETWORK_PLAYER_REGION=germany
