# The build context for restricted/docker/Dockerfile: the source only, never a host's own files or build output.
.git
.github
.claude
.workspace
**/node_modules
**/dist
**/build
**/target
**/target*
# ...but not a module named target (rustic-isles-db, the legacy importer)
!**/src/**/target.rs
paradox
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.pfx
**/*.log
# The Rust tests' fixtures hold fake env files and certificates (the test image runs them)
!**/tests/fixtures/**

# A host's own game data and exports (rustic-isles' .gitignore): mounted as volumes, never baked in
restricted/modules/rustic-isles/reference/1.14.7/ParadoxBackend/game-data/*.json
restricted/modules/rustic-isles/reference/1.14.7/ParadoxDirector/game-data/*.json
!restricted/modules/rustic-isles/reference/1.14.7/ParadoxBackend/game-data/*.example.json
!restricted/modules/rustic-isles/reference/1.14.7/ParadoxDirector/game-data/*.example.json
restricted/modules/rustic-isles/reference/1.14.7/ParadoxBackend/game-data/raw
restricted/modules/rustic-isles/reference/1.14.7/ParadoxDirector/game-data/raw
restricted/modules/rustic-isles/reference/1.14.7/Items_Analysis
restricted/modules/rustic-isles/reference/1.14.7/DauntlessEndpointDocumentation
restricted/modules/rustic-isles/native/runtime/SDK
restricted/modules/rustic-isles/native/runtime/SDK.hpp
restricted/modules/rustic-isles/native/runtime/x64
**/.git
ui

# Not used by any image
launcher/node_modules
restricted/launcher/node_modules
docs
restricted/docs
