# The dashboard's environment (docs/integration.md). Everything a person tunes is in Settings instead.

# The public origin, behind your TLS reverse proxy. The OAuth redirect is <this>/api/auth/discord/callback.
DASHBOARD_BASE_URL=http://localhost:3000

# A Discord application (discord.com/developers): OAuth2 client id and secret.
DASHBOARD_DISCORD_CLIENT_ID=
DASHBOARD_DISCORD_CLIENT_SECRET=
# Comma-separated Discord user ids that are owners from their first sign-in.
DASHBOARD_OWNER_DISCORD_IDS=

# The admin service's GraphQL, and REFORGED_ADMIN_API_KEY from the host kit's secrets.env.
DASHBOARD_ADMIN_API_URL=http://127.0.0.1:61003/graphql
DASHBOARD_ADMIN_API_KEY=

# The backend, and MYSTICPARADOX_MANAGER_OPERATOR_SECRET from secrets.env (the backend needs MYSTICPARADOX_MANAGER_ADMIN=on).
DASHBOARD_BACKEND_URL=http://127.0.0.1:61000
DASHBOARD_MANAGER_OPERATOR_SECRET=

# What the backend sends with chat and reports: 32 or more random characters. Ingest is off without it.
DASHBOARD_INGEST_KEY=

# Where the database lives (default ./data/dashboard.db).
#DASHBOARD_DATA_DIR=./data
#DASHBOARD_SESSION_DAYS=7

# Development only, ignored in production: a sign-in button for the first owner id, without Discord.
#DASHBOARD_DEV_LOGIN=on
