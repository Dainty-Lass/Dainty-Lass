# The build context for docker/Dockerfile (D-2): the root workspace's source only, never a host's files or build output.
.git
**/.git
.github
.forgejo
.claude
.workspace
**/node_modules
**/dist
**/build
**/target
**/target*
# ...but not a module named target (rustic-isles-db, the legacy importer)
!**/src/**/target.rs
paradox
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.pfx
**/*.log
# The Rust tests' fixtures hold fake env files and certificates (the test image runs them)
!**/tests/fixtures/**
ui
docs
fuzz
native

# A host's own game data and exports: mounted as volumes, never baked in
**/game-data/*/backend/*.json
**/game-data/*/director/*.json
!**/game-data/*/backend/*.example.json
!**/game-data/*/director/*.example.json
**/game-data/*/backend/raw
**/game-data/*/director/raw
**/game-data/*/exports
**/game-data/*/captures
**/Items_Analysis

# A checkout's leftovers from before restricted/ was retired
restricted
