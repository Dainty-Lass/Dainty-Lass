# Settings for compose.yaml (docs/hosting-docker.md): copy to .env and edit. The server's own settings (public or
# private, name, address, ports, editions) are .workspace/config/server.toml in the workspace volume.

# A private server: the Tailscale network namespace (compose.tailscale.yaml); ; instead of : on Windows
#COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
#TS_AUTHKEY=tskey-auth-...

# Your Dauntless 1.14.7 folder (the one with Archon), mounted at /game: the game servers run from it
REFORGED_GAME_DIR=./game
# Files for the host kit's commands, mounted read-only at /import (the runtime's DLLs, game data packs)
REFORGED_IMPORT_DIR=./import

# Public server: the gateway's port as server.toml has it (gateway_port, 443 for a public server) ...
REFORGED_GATEWAY_PORT=443
# ... and where the host publishes it ([address:]port; the invites name server.toml's port, so keep them the same)
REFORGED_GATEWAY_PUBLISH=443
# The game servers' UDP ports: Reforged's 8770-8777; 8770-8787 with Refined's too (server.toml's editions)
REFORGED_GAME_PORTS=8770-8777
REFORGED_GAME_PUBLISH_ADDRESS=0.0.0.0

# The commit the server names to players (the AGPL source offer), baked in at build time:
#REFORGED_COMMIT=  (git rev-parse --short=12 HEAD)
# Image name, for a registry: <REFORGED_IMAGE>-server:<REFORGED_TAG>
#REFORGED_IMAGE=reforged-revival
#REFORGED_TAG=local
