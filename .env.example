# Docker Compose's settings for Dainty Lass: copy this file to .env beside compose.yaml and run Compose from there.
# These are Compose's own, read on this machine. The server's settings are setup's, not these:
#   docker compose run --rm host setup ...

# Which profiles run: public adds the allowlist, which closes the game ports to anyone not signed in.
# public,toml applies the host.toml in DAINTY_CONFIG_DIR on every start; public,postgres stores in PostgreSQL.
COMPOSE_PROFILES=public

# A private server over Tailscale (compose.tailscale.yaml; use ; instead of : on Windows)
# COMPOSE_FILE=compose.yaml:compose.tailscale.yaml
# Needed for the Tailscale node's first start only
# TS_AUTHKEY=tskey-auth-...

# The Dauntless 1.14.7 folder, mounted at /game. An empty folder works: install-game fetches 1.14.7 into it
DAINTY_GAME_DIR=./game
# Files for host import commands, mounted read-only at /import
DAINTY_IMPORT_DIR=./import
# The toml profile's host.toml, mounted read-only at /config
DAINTY_CONFIG_DIR=./config

# The gateway's port in the container: setup's port (443, or its --public-port)
DAINTY_GATEWAY_PORT=443
# Where it is published, [address:]port. Invites name setup's port, so keep the two equal
DAINTY_GATEWAY_PUBLISH=443
# The game servers' UDP range, the same on both sides: 8770-8777 for up to 6 hunts, and one more below 8770 for
# each hunt above 6 (8766-8777 for 10)
DAINTY_GAME_PORTS=8770-8777
DAINTY_GAME_PUBLISH_ADDRESS=0.0.0.0

# The commit the server names to players as its source, baked in at build time: git rev-parse --short=12 HEAD
# DAINTY_COMMIT=
# Image names: <DAINTY_IMAGE>-front, -server, -netem, -test, tagged DAINTY_TAG
# DAINTY_IMAGE=dainty-lass
# DAINTY_TAG=local
# POSTGRES_IMAGE=postgres:17

# The network profile's test cluster (docker/network/test.sh). None of this is a server's setting.
# The cluster's first three octets
# DAINTY_NETWORK_SUBNET=172.28.77
# DAINTY_NETWORK_PUBLISH_ADDRESS=127.0.0.1
# DAINTY_NETWORK_PORT_OREGON=18441
# DAINTY_NETWORK_PORT_NEW_YORK=18442
# DAINTY_NETWORK_PORT_UK=18443
# DAINTY_NETWORK_PORT_GERMANY=18444
# Round trips between the regions in ms; each way takes half
# DAINTY_NETWORK_RTT_OREGON_NEW_YORK=70
# DAINTY_NETWORK_RTT_OREGON_UK=140
# DAINTY_NETWORK_RTT_OREGON_GERMANY=150
# DAINTY_NETWORK_RTT_NEW_YORK_UK=75
# DAINTY_NETWORK_RTT_NEW_YORK_GERMANY=85
# DAINTY_NETWORK_RTT_UK_GERMANY=20
# The region this machine plays from
# DAINTY_NETWORK_PLAYER_REGION=germany
