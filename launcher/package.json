{
  "name": "dainty-lass-launcher",
  "version": "2.0.0-beta",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "bridge-data": "bun scripts/bridge-data.ts",
    "test": "bun run bridge-data && bun test test/",
    "typecheck": "bun run bridge-data && tsc --noEmit",
    "dev": "cd ../crates/dainty-launcher-app && tauri dev -- --features realms",
    "dev:manager": "cd ../crates/dainty-launcher-app && tauri dev --config tauri.server-gui.conf.json -- --no-default-features --features server-gui",
    "build:pages": "bun scripts/dashboard-page.ts build launcher && bun scripts/dashboard-page.ts build server-manager",
    "e2e:desktop": "bun e2e/desktop.ts",
    "e2e:remote": "bun e2e/remote.ts"
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/bun": "1.4.5",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
}
