{
  "name": "dainty-lass-launcher",
  "productName": "DaintyLass Launcher",
  "version": "2.0.0-alpha.0",
  "description": "The Tauri launcher's CLI and the tests of its bridge: dainty-lass-ui's page API (ui/packages/bridge) against the isolation hook (MIGRATION_PLAN.md section 4.6; docs/dainty-lass-plan.md, DU2).",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "tauri": "tauri",
    "build:ui": "bun install --cwd ../../ui --frozen-lockfile && bun run --cwd ../../ui build",
    "build": "tauri build --bundles nsis -- --features legacy,realms",
    "build:client": "tauri build --bundles nsis -- --features legacy,realms",
    "build:server-gui": "tauri build --bundles nsis --config src-tauri/tauri.server-gui.conf.json -- --no-default-features --features server-gui",
    "build:manager": "npm run build:server-gui",
    "build:all": "npm run build:client && npm run build:server-gui",
    "dev": "tauri dev -- --features legacy,realms",
    "dev:server-gui": "tauri dev --config src-tauri/tauri.server-gui.conf.json -- --no-default-features --features server-gui",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import ./test/resolve-ui.ts --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
